<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="benchmarkRunId" value="${mdc:benchmarkRunId:-bootstrap}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n%wEx</pattern>
        </encoder>
    </appender>

    <appender name="EVENTS_FILE" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator>
            <key>benchmarkRunId</key>
            <defaultValue>bootstrap</defaultValue>
        </discriminator>
        <sift>
            <appender name="EVENTS_FILE_${benchmarkRunId}" class="ch.qos.logback.core.FileAppender">
                <file>logs/benchmark-run-${benchmarkRunId}.jsonl</file>
                <append>true</append>
                <encoder>
                    <pattern>%msg%n</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <logger name="BENCHMARK_EVENTS" level="INFO" additivity="false">
        <appender-ref ref="EVENTS_FILE"/>
    </logger>

    <logger name="org.springframework.context.support.PostProcessorRegistrationDelegate$BeanPostProcessorChecker" level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
